# https://editorconfig.org - the same line endings and indentation in every editor (the files in the repository are UTF-8 with LF endings).
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json}]
indent_size = 2

[*.md]
# two trailing spaces mean a line break in Markdown
trim_trailing_whitespace = false

[*.{cmd,bat}]
end_of_line = crlf

[mvnw]
end_of_line = lf
