<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="QuanLySanPhamRoot"
            maxHeight="1000"
            maxWidth="1600"
            prefHeight="1000"
            prefWidth="1600"
            stylesheets="@../css/quanlysanpham.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeeshop.coffeeshopmanagement.controller.ProductController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="%nav.home"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button text="%nav.products"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="%nav.orders"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="%nav.customers"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="%nav.categories"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="%nav.accounts"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="%nav.logout"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="%nav.tagline"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->

    <center>
        <VBox styleClass="content">

            <!-- ================= HEADER ================= -->

            <HBox alignment="CENTER_LEFT"
                  spacing="10"
                  prefHeight="72"
                  styleClass="page-header">

                <VBox HBox.hgrow="ALWAYS" spacing="3">
                    <Label text="%products.title"
                           styleClass="page-title"/>
                    <Label text="%products.subtitle"
                           styleClass="page-description"/>
                </VBox>

                <Label text="♧"
                       styleClass="header-icon"/>

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="Admin"
                           styleClass="admin-name"/>
                    <Label text="%role.admin"
                           styleClass="admin-role"/>
                </VBox>

                <Label text="◎"
                       styleClass="profile-icon"/>
            </HBox>

            <!-- ================= CATEGORY TABS ================= -->

            <ScrollPane fitToHeight="true"
                        vbarPolicy="NEVER"
                        hbarPolicy="AS_NEEDED"
                        style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;">
                <HBox fx:id="productCategoryTabsBox"
                      spacing="8"
                      alignment="CENTER_LEFT"
                      styleClass="category-tabs"/>
            </ScrollPane>

            <!-- ================= PRODUCT AREA ================= -->

            <HBox spacing="12"
                  VBox.vgrow="ALWAYS">

                <!-- ================= CATEGORY LIST ================= -->

                <VBox prefWidth="225"
                      minWidth="225"
                      maxWidth="225"
                      spacing="8"
                      styleClass="category-card">

                    <Label text="%products.categories.title"
                           styleClass="card-title"/>

                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                style="-fx-background-color: transparent; -fx-background: transparent; -fx-padding: 0;"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="categoryListBox"
                              spacing="6"/>
                    </ScrollPane>

                    <Button maxWidth="1.7976931348623157E308"
                            prefHeight="36"
                            mnemonicParsing="false"
                            styleClass="add-category-button"
                            text="%categories.add"
                            fx:id="addCategoryButton"
                            onAction="#handleAddCategory"/>
                </VBox>

                <!-- ================= PRODUCT TABLE ================= -->

                <VBox spacing="10"
                      HBox.hgrow="ALWAYS"
                      styleClass="table-card">

                    <!-- SEARCH + FILTER -->

                    <HBox alignment="CENTER_LEFT" spacing="8">

                        <TextField fx:id="searchField"
                                   promptText="%products.search.prompt"
                                   HBox.hgrow="ALWAYS"
                                   styleClass="search-field"/>

                        <ComboBox fx:id="categoryFilter"
                                  prefWidth="125"
                                  promptText="%products.col.category"
                                  styleClass="filter-combo"
                                  onAction="#handleCategoryFilter"/>

                        <ComboBox fx:id="statusFilter"
                                  prefWidth="115"
                                  promptText="%products.filter.status.prompt"
                                  styleClass="filter-combo"
                                  onAction="#handleStatusFilter"/>

                        <!-- Move the selected product within its category on the sales screen (TODO 5.31) -->
                        <Button mnemonicParsing="false" onAction="#handleMoveProductUp" text="%sort.up"/>
                        <Button mnemonicParsing="false" onAction="#handleMoveProductDown" text="%sort.down"/>

                        <Button fx:id="addProductButton"
                                mnemonicParsing="false"
                                styleClass="primary-button"
                                text="%products.add"
                                onAction="#handleAddProduct"/>
                    </HBox>

                    <!-- TABLE -->

                    <TableView fx:id="productTable"
                               VBox.vgrow="ALWAYS"
                               styleClass="product-table">

                        <columns>
                            <TableColumn fx:id="imageColumn"
                                         text="%products.col.image"
                                         prefWidth="65"/>

                            <TableColumn fx:id="nameColumn"
                                         text="%products.col.name"
                                         prefWidth="220"/>

                            <TableColumn fx:id="categoryColumn"
                                         text="%products.col.category"
                                         prefWidth="120"/>

                            <TableColumn fx:id="sellingPriceColumn"
                                         text="%products.col.price"
                                         prefWidth="110"/>

                            <TableColumn fx:id="stockColumn"
                                         text="%products.col.stock"
                                         prefWidth="90"/>

                            <TableColumn fx:id="productStatusColumn"
                                         text="%history.col.status"
                                         prefWidth="120"/>

                            <TableColumn fx:id="actionColumn"
                                         text="%customers.col.actions"
                                         prefWidth="120"/>
                        </columns>

                        <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                        <placeholder>
                            <Label text="%products.empty"
                                   styleClass="empty-label"/>
                        </placeholder>
                    </TableView>

                    <!-- FOOTER -->

                    <HBox alignment="CENTER_LEFT" spacing="5">

                        <Label fx:id="totalProductLabel"
                               text="%products.total.initial"
                               styleClass="table-footer"/>

                        <Region HBox.hgrow="ALWAYS"/>

                        <HBox fx:id="productPagerBox" alignment="CENTER_RIGHT"/>
                    </HBox>

                </VBox>
            </HBox>
        </VBox>
    </center>

</BorderPane>