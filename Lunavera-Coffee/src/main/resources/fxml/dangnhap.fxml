<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="loginRoot"
           prefHeight="720.0"
           prefWidth="1280.0"
           stylesheets="@../css/dangnhap.css"
           xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.coffeeshop.coffeeshopmanagement.controller.LoginController">

   <!-- Background -->
   <ImageView fx:id="backgroundImage"
              fitHeight="720"
              fitWidth="1280"
              pickOnBounds="true"
              preserveRatio="false">
      <image>
         <Image url="@../images/LoginBackground.png"/>
      </image>
   </ImageView>

   <!-- Overlay -->
   <AnchorPane styleClass="login-overlay"/>

   <!-- Login Card: Căn sát phải bằng StackPane.alignment và cách mép phải 100px -->
   <VBox fx:id="loginCard"
         alignment="CENTER"
         maxHeight="620"
         maxWidth="410"
         prefHeight="620"
         prefWidth="410"
         spacing="0"
         styleClass="login-card"
         StackPane.alignment="CENTER_RIGHT">

      <StackPane.margin>
         <Insets right="300.0" />
      </StackPane.margin>

      <padding>
         <Insets bottom="35" left="45" right="45" top="35"/>
      </padding>

      <!-- Logo -->
      <ImageView fx:id="logoImage"
                 fitHeight="80"
                 fitWidth="150"
                 preserveRatio="true">
         <image>
            <Image url="@../images/LunaveraLogo.png"/>
         </image>
      </ImageView>

      <!-- Title -->
      <Label styleClass="login-title" text="%login.title">
         <VBox.margin>
            <Insets bottom="8" top="8"/>
         </VBox.margin>
      </Label>

      <!-- Subtitle -->
      <Label alignment="CENTER"
             maxWidth="310"
             styleClass="login-subtitle"
             text="%login.subtitle"
             wrapText="true">
         <VBox.margin>
            <Insets bottom="20"/>
         </VBox.margin>
      </Label>

      <!-- Username -->
      <VBox maxWidth="310" prefWidth="310" spacing="6">
         <Label styleClass="field-label" text="%login.username.label"/>
         <TextField fx:id="usernameField"
                    maxWidth="310"
                    prefHeight="42"
                    prefWidth="310"
                    promptText="%login.username.prompt"
                    styleClass="login-field"/>
      </VBox>

      <!-- Password -->
      <VBox maxWidth="310" prefWidth="310" spacing="6">
         <VBox.margin>
            <Insets top="12"/>
         </VBox.margin>
         <Label styleClass="field-label" text="%login.password.label"/>
         <HBox alignment="CENTER_LEFT" maxWidth="310" prefWidth="310" spacing="0" styleClass="password-box">
            <PasswordField fx:id="passwordField"
                           maxWidth="Infinity"
                           prefHeight="42"
                           prefWidth="260"
                           promptText="%login.password.prompt"
                           styleClass="password-inner"
                           HBox.hgrow="ALWAYS"/>
            <Button fx:id="showPasswordButton"
                    focusTraversable="false"
                    minWidth="44"
                    prefHeight="42"
                    prefWidth="44"
                    styleClass="password-eye">
               <tooltip><Tooltip text="%login.password.toggle"/></tooltip>
            </Button>
         </HBox>
         <!-- TODO 5.26: shown by CapsLockWarning while Caps Lock seems to be on -->
         <Label fx:id="capsLockLabel" managed="false" visible="false"
                style="-fx-text-fill: #b45309; -fx-font-weight: bold; -fx-font-size: 12px;" text="%capslock.warning"/>
      </VBox>

      <Region prefHeight="24"/>

      <!-- Login button -->
      <Button fx:id="loginButton"
              maxWidth="310"
              onAction="#handleLogin"
              prefHeight="45"
              prefWidth="310"
              styleClass="login-button"
              text="%login.button"/>

   </VBox>

   <!-- Where the data is (TODO 5.25): a small line so the owner can tell at a glance which shop's data this is -->
   <Label fx:id="dataLocationLabel"
          maxWidth="900"
          styleClass="data-location"
          StackPane.alignment="BOTTOM_CENTER">
      <StackPane.margin>
         <Insets bottom="14.0"/>
      </StackPane.margin>
   </Label>

   <!-- Language switch (TODO 1.7): top right, outside the card so it never changes the card's size.
        A pill with a green "thumb" that slides under the chosen language (LoginController animates it).
        Both segments are exactly 86 wide: the thumb moves by that much. -->
   <StackPane alignment="CENTER_LEFT"
              maxHeight="-Infinity"
              maxWidth="-Infinity"
              styleClass="language-switch"
              StackPane.alignment="TOP_RIGHT">
      <StackPane.margin>
         <Insets right="24" top="20"/>
      </StackPane.margin>
      <Region fx:id="languageThumb"
              maxHeight="28.0"
              maxWidth="86.0"
              minHeight="28.0"
              minWidth="86.0"
              mouseTransparent="true"
              prefHeight="28.0"
              prefWidth="86.0"
              styleClass="language-thumb"/>
      <HBox maxWidth="-Infinity" spacing="0">
         <Button fx:id="languageViButton"
                 focusTraversable="false"
                 maxHeight="28.0"
                 maxWidth="86.0"
                 minHeight="28.0"
                 minWidth="86.0"
                 onAction="#chooseVietnamese"
                 prefHeight="28.0"
                 prefWidth="86.0"
                 styleClass="language-button"
                 text="%lang.vi">
            <tooltip>
               <Tooltip text="%lang.tooltip"/>
            </tooltip>
         </Button>
         <Button fx:id="languageEnButton"
                 focusTraversable="false"
                 maxHeight="28.0"
                 maxWidth="86.0"
                 minHeight="28.0"
                 minWidth="86.0"
                 onAction="#chooseEnglish"
                 prefHeight="28.0"
                 prefWidth="86.0"
                 styleClass="language-button"
                 text="%lang.en">
            <tooltip>
               <Tooltip text="%lang.tooltip"/>
            </tooltip>
         </Button>
      </HBox>
   </StackPane>

</StackPane>