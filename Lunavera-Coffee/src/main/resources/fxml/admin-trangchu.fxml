<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="dashboardRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            stylesheets="@../css/admin-trangchu.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeeshop.coffeeshopmanagement.controller.AdminDashboardController"
            styleClass="dashboard">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="%nav.home"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="%nav.products"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="%nav.orders"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="%nav.customers"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="%nav.categories"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="%nav.accounts"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>

                <Button text="%nav.staff"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openStaffManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="%nav.logout"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="%nav.tagline"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20.0" styleClass="content">

            <!-- DATABASE HEALTH LINE (TODO 4.24): filled by code for an administrator -->
            <VBox fx:id="databaseHealthBox" spacing="6.0" visible="false" managed="false">
                <Label fx:id="databaseHealthLabel" wrapText="true" styleClass="db-health-line"/>
                <Label fx:id="databaseHealthWarningLabel" wrapText="true" visible="false" managed="false"
                       styleClass="stale-order-warning"/>
                <!-- the second place for the backups (TODO 4.35) -->
                <Label fx:id="secondBackupLabel" wrapText="true" styleClass="db-health-line"/>
            </VBox>

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0">
                <VBox spacing="4.0">
                    <Label fx:id="dashboardGreetingLabel" text="%dashboard.greeting.default" styleClass="page-title"/>
                    <Label text="%dashboard.subtitle"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="backupButton"
                        text="%admin.backup"
                        prefHeight="42.0"
                        styleClass="secondary-button"
                        onAction="#handleBackupData"/>
                <Region prefWidth="10.0"/>

                <Button fx:id="restoreButton"
                        text="%admin.restore"
                        prefHeight="42.0"
                        styleClass="secondary-button"
                        onAction="#handleRestoreData"/>
                <Region prefWidth="10.0"/>

                <Button fx:id="transferQrButton"
                        text="%admin.qr"
                        prefHeight="42.0"
                        styleClass="secondary-button"
                        onAction="#handleSetTransferQr"/>
                <Region prefWidth="10.0"/>

                <!-- Shown only when the shop's database is MariaDB/MySQL (set in AdminDashboardController.initialize). -->
                <HBox fx:id="phpMyAdminBox" visible="false" managed="false" alignment="CENTER_LEFT">
                    <Button fx:id="phpMyAdminButton"
                            text="%admin.phpmyadmin"
                            prefHeight="42.0"
                            styleClass="secondary-button"
                            onAction="#handleOpenPhpMyAdmin"/>
                    <Region prefWidth="10.0"/>
                </HBox>

                <Button fx:id="reportButton"
                        text="%admin.report"
                        prefHeight="42.0"
                        styleClass="primary-button"
                        onAction="#handleShowReports"/>
                <Region prefWidth="16.0"/>

                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="dashboardAccountNameLabel" text="Admin" styleClass="account-name"/>
                    <Label text="%role.admin" styleClass="account-role"/>
                </VBox>
            </HBox>

            <!-- TOOLS FOR THE ADMINISTRATOR: security log (TODO 4.44) and unused pictures (TODO 4.27) -->
            <HBox alignment="CENTER_RIGHT" spacing="10.0">
                <Button text="%admin.seclog"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        onAction="#handleShowSecurityLog"/>
                <Button text="%admin.pics"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        onAction="#handleCleanUnusedPictures"/>
                <Button text="%admin.tables"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        onAction="#handleManageTables"/>
                <Button text="%admin.settings"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        onAction="#handleOpenSettings"/>
                <Button text="%backup2.button"
                        prefHeight="36.0"
                        styleClass="secondary-button"
                        onAction="#handleSecondBackupFolder"/>
            </HBox>

            <!-- STATISTICS -->

            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.products.title" styleClass="stat-title"/>
                    <Label fx:id="dashboardProductCountLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label fx:id="dashboardLowStockNoteLabel"
                           text="%common.loading"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.orders.title" styleClass="stat-title"/>
                    <Label fx:id="todayOrderLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="%stats.orders.caption"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.revenue.title" styleClass="stat-title"/>
                    <Label fx:id="todayRevenueLabel"
                           text="%money.zero"
                           styleClass="stat-value"/>
                    <Label text="%stats.revenue.caption"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.customers.title" styleClass="stat-title"/>
                    <Label fx:id="todayCustomerLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="%stats.customers.caption"
                           styleClass="stat-description"/>
                </VBox>
            </GridPane>

            <!-- MAIN DASHBOARD CONTENT (2 COLUMNS) -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                <!-- LEFT COLUMN: LINE CHART + DINING TABLE GRID (12 BÀN) -->
                <VBox spacing="16.0" HBox.hgrow="ALWAYS">

                    <!-- DOANH THU 7 NGÀY GẦN ĐÂY -->
                    <VBox prefHeight="280.0"
                          spacing="12.0"
                          styleClass="content-card">

                        <HBox alignment="CENTER_LEFT">
                            <Label text="%chart.revenue.title"
                                   styleClass="section-title"/>

                            <Region HBox.hgrow="ALWAYS"/>

                            <Label text="%chart.revenue.range"
                                   styleClass="filter-label"/>
                        </HBox>

                        <LineChart fx:id="revenueChart"
                                   animated="false"
                                   legendVisible="false"
                                   createSymbols="true"
                                   verticalGridLinesVisible="false"
                                   horizontalGridLinesVisible="true"
                                   VBox.vgrow="ALWAYS">

                            <xAxis>
                                <CategoryAxis fx:id="revenueXAxis"
                                              label="%chart.axis.date"/>
                            </xAxis>

                            <yAxis>
                                <NumberAxis fx:id="revenueYAxis"
                                            label="%report.col.revenue"/>
                            </yAxis>
                        </LineChart>
                    </VBox>

                    <!-- SƠ ĐỒ BÀN PHỤC VỤ (12 BÀN) -->
                    <VBox spacing="14.0"
                          styleClass="content-card"
                          VBox.vgrow="ALWAYS">

                        <HBox alignment="CENTER_LEFT" spacing="12.0">
                            <VBox spacing="3.0">
                                <Label text="%tables.map.title"
                                       styleClass="section-title"/>
                                <Label text="%tables.map.subtitle"
                                       styleClass="section-subtitle"/>
                            </VBox>

                            <Region HBox.hgrow="ALWAYS"/>

                            <!-- STATUS LEGENDS -->
                            <HBox spacing="14.0" alignment="CENTER">
                                <HBox spacing="6.0" alignment="CENTER">
                                    <Label text="●" styleClass="status-dot-occupied"/>
                                    <Label text="%tables.status.occupied" styleClass="status-legend-text"/>
                                </HBox>

                                <HBox spacing="6.0" alignment="CENTER">
                                    <Label text="●" styleClass="status-dot-empty"/>
                                    <Label text="%tables.status.free" styleClass="status-legend-text"/>
                                </HBox>
                            </HBox>
                        </HBox>

                        <!-- TABLE MAP: 3 columns, as many rows as there are tables; scrolls (TODO 3.48) -->
                        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" style="-fx-background-color: transparent;"
                                    VBox.vgrow="ALWAYS">
                            <GridPane fx:id="homeTableGrid"
                                      hgap="12.0"
                                      vgap="12.0">
                                <columnConstraints>
                                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                    <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                </columnConstraints>
                            </GridPane>
                        </ScrollPane>
                    </VBox>
                </VBox>

                <!-- RIGHT COLUMN: THỐNG KÊ ĐƠN HÀNG HÔM NAY (KÉO DÀI HẾT CHIỀU CAO) & ĐƠN HÀNG GẦN ĐÂY BÊN DƯỚI -->
                <VBox prefWidth="360.0"
                      minWidth="340.0"
                      maxWidth="380.0"
                      spacing="14.0"
                      styleClass="content-card"
                      VBox.vgrow="ALWAYS">

                    <Label text="%orders.today.title"
                           styleClass="section-title"/>

                    <!-- 3 TRẠNG THÁI ĐƠN -->
                    <VBox spacing="10.0" styleClass="order-summary-box">
                        <HBox alignment="CENTER_LEFT">
                            <Label text="%orders.status.paid"
                                   styleClass="order-status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="paidOrderLabel"
                                   text="0"
                                   styleClass="order-status-value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="%orders.status.open"
                                   styleClass="order-status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="openOrderLabel"
                                   text="0"
                                   styleClass="order-status-value"/>
                        </HBox>

                        <HBox alignment="CENTER_LEFT">
                            <Label text="%orders.status.cancelled"
                                   styleClass="order-status-label"/>
                            <Region HBox.hgrow="ALWAYS"/>
                            <Label fx:id="cancelledOrderLabel"
                                   text="0"
                                   styleClass="order-status-value"/>
                        </HBox>

                        <Label fx:id="staleOrderLabel"
                               text=""
                               wrapText="true"
                               visible="false"
                               managed="false"
                               styleClass="stale-order-warning"/>
                    </VBox>

                    <!-- TIÊU ĐỀ PHẦN ĐƠN HÀNG GẦN ĐÂY / TRONG NGÀY -->
                    <HBox alignment="CENTER_LEFT">
                        <Label text="%orders.recent.title"
                               styleClass="section-subtitle"
                               style="-fx-font-weight: bold; -fx-text-fill: #274917;"/>
                    </HBox>

                    <!-- DANH SÁCH ĐƠN HÀNG (SCROLLPANE) -->
                    <ScrollPane fitToWidth="true"
                                hbarPolicy="NEVER"
                                vbarPolicy="AS_NEEDED"
                                styleClass="today-orders-scroll"
                                VBox.vgrow="ALWAYS">
                        <VBox fx:id="todayOrdersContainer"
                              spacing="8.0"
                              styleClass="today-orders-container"/>
                    </ScrollPane>

                    <Button text="%orders.viewall"
                            maxWidth="1.7976931348623157E308"
                            prefHeight="42.0"
                            styleClass="secondary-button"
                            onAction="#openOrderManagement"/>
                </VBox>
            </HBox>

        </VBox>
    </center>
</BorderPane>