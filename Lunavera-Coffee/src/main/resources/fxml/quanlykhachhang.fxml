<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="quanLyKhachHangRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            stylesheets="@../css/admin-trangchu.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeeshop.coffeeshopmanagement.controller.CustomerController"
            styleClass="dashboard">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="%nav.home"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button fx:id="productMenuButton"
                        text="%nav.products"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="%nav.orders"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="%nav.customers"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>
            </VBox>

            <Separator fx:id="categorySeparator" styleClass="sidebar-separator"/>

            <VBox fx:id="adminMenuBox" spacing="6.0">
                <Button fx:id="categoryMenuButton"
                        text="%nav.categories"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button fx:id="accountMenuButton"
                        text="%nav.accounts"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>

                <Button text="%nav.staff"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openStaffManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="%nav.logout"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="%nav.tagline"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20.0" styleClass="content">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0">
                <VBox spacing="4.0">
                    <Label text="%customers.title" styleClass="page-title"/>
                    <Label text="%customers.subtitle"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="accountNameLabel" text="Admin" styleClass="account-name"/>
                    <Label fx:id="accountRoleLabel" text="%role.admin" styleClass="account-role"/>
                </VBox>
            </HBox>

            <!-- SEARCH AND ACTIONS -->
            <HBox alignment="CENTER_LEFT" spacing="12.0">
                <TextField fx:id="customerSearchField"
                           promptText="%customers.search.prompt"
                           prefHeight="42.0"
                           prefWidth="400.0"
                           styleClass="search-field"/>

                <Region HBox.hgrow="ALWAYS"/>

                <Button fx:id="addCustomerButton"
                        text="%customers.add"
                        prefHeight="42.0"
                        styleClass="primary-button"
                        onAction="#handleAddCustomer"/>
            </HBox>

            <!-- CUSTOMER TABLE -->
            <VBox VBox.vgrow="ALWAYS" styleClass="content-card">
                <TableView fx:id="customerTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="customerIndexColumn" prefWidth="70.0" text="STT"/>
                        <TableColumn fx:id="customerNameColumn" prefWidth="250.0" text="%customers.col.name"/>
                        <TableColumn fx:id="customerPhoneColumn" prefWidth="180.0" text="%customers.col.phone"/>
                        <TableColumn fx:id="customerEmailColumn" prefWidth="250.0" text="Email"/>
                        <TableColumn fx:id="customerLoyaltyColumn" prefWidth="150.0" text="%customers.col.points"/>
                        <TableColumn fx:id="customerTierColumn" prefWidth="180.0" text="%customers.col.tier"/>
                        <TableColumn fx:id="customerVisitsColumn" prefWidth="90.0" text="%customers.col.visits"/>
                        <TableColumn fx:id="customerSpentColumn" prefWidth="140.0" text="%customers.col.spent"/>
                        <TableColumn fx:id="customerLastVisitColumn" prefWidth="140.0" text="%customers.col.last"/>
                        <TableColumn fx:id="customerActionColumn" prefWidth="100.0" text="%customers.col.actions"/>
                    </columns>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                    </columnResizePolicy>

                    <placeholder>
                        <Label text="%customers.empty"/>
                    </placeholder>
                </TableView>

                <HBox alignment="CENTER_LEFT" spacing="8.0">
                    <padding>
                        <Insets top="10.0"/>
                    </padding>
                    <Label fx:id="customerPaginationLabel" styleClass="table-footer" text="%customers.pagination.initial"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <HBox fx:id="customerPagerBox" alignment="CENTER_RIGHT"/>
                </HBox>
            </VBox>

        </VBox>
    </center>

</BorderPane>
