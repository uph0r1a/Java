<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="QuanLyDanhMucRoot" maxHeight="1000" maxWidth="1600" prefHeight="1000" prefWidth="1600" stylesheets="@../css/quanlydanhmuc.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.coffeeshopmanagement.controller.CategoryController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="%nav.home"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button text="%nav.products"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="%nav.orders"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="%nav.customers"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="%nav.categories"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="%nav.accounts"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="%nav.logout"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="%nav.tagline"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <VBox styleClass="content">

            <!-- ================= HEADER ================= -->
            <HBox alignment="CENTER_LEFT" prefHeight="72" spacing="10" styleClass="page-header">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="page-title" text="%categories.title" />
                    <Label styleClass="page-description" text="%categories.subtitle" />
                </VBox>

                <Label styleClass="header-icon" text="▦" />

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label styleClass="admin-name" text="Admin" />
                    <Label styleClass="admin-role" text="%role.admin" />
                </VBox>

                <Label styleClass="profile-icon" text="◎" />
            </HBox>

            <!-- ================= STATISTICS ================= -->
            <HBox spacing="12" styleClass="statistics">
                <!-- Tổng danh mục -->
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon" text="▦" />
                    <Label styleClass="stat-title" text="%categories.stat.total" />
                    <Label fx:id="totalCategoryLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%categories.stat.total.caption" />
                </VBox>

                <!-- Đang hoạt động -->
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon-active" text="●" />
                    <Label styleClass="stat-title" text="%categories.stat.active" />
                    <Label fx:id="activeCategoryLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%categories.stat.active.caption" />
                </VBox>

                <!-- Tạm ẩn -->
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon-hidden" text="●" />
                    <Label styleClass="stat-title" text="%categories.stat.hidden" />
                    <Label fx:id="hiddenCategoryLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%categories.stat.hidden.caption" />
                </VBox>

                <!-- Tổng sản phẩm -->
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon" text="+" />
                    <Label styleClass="stat-title" text="%categories.stat.products" />
                    <Label fx:id="totalCategoryProductLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%categories.stat.products.caption" />
                </VBox>
            </HBox>

            <!-- ================= CATEGORY LIST ================= -->
            <VBox spacing="10" styleClass="category-card" VBox.vgrow="ALWAYS">

                <!-- ================= LIST HEADER ================= -->
                <HBox alignment="CENTER_LEFT" spacing="10">
                    <Label styleClass="section-title" text="%categories.list.title" />
                    <Region HBox.hgrow="ALWAYS" />
                    <TextField fx:id="categorySearchField" onAction="#handleSearchAction" prefWidth="320" promptText="%categories.search.prompt" styleClass="search-field" />
                    <!-- Move the selected category along the tabs of the sales screen (TODO 5.31) -->
                    <Button mnemonicParsing="false" onAction="#handleMoveCategoryUp" text="%sort.up" />
                    <Button mnemonicParsing="false" onAction="#handleMoveCategoryDown" text="%sort.down" />
                    <Button fx:id="addCategoryButton" mnemonicParsing="false" onAction="#handleAddCategory" styleClass="primary-button" text="%categories.add" />
                </HBox>

                <!-- ================= TABLE ================= -->
                <TableView fx:id="categoryTable" onMouseClicked="#handleTableClick" styleClass="category-table" VBox.vgrow="ALWAYS">
                    <columns>
                        <!-- STT -->
                        <TableColumn fx:id="categoryIndexColumn" minWidth="55" prefWidth="65" text="STT" />

                        <!-- Ảnh -->
                        <TableColumn fx:id="categoryImageColumn" minWidth="70" prefWidth="80" text="" />

                        <!-- Tên -->
                        <TableColumn fx:id="categoryNameColumn" minWidth="220" prefWidth="280" text="%categories.col.name" />

                        <!-- Mô tả -->
                        <TableColumn fx:id="categoryDescriptionColumn" minWidth="300" prefWidth="430" text="%common.col.description" />

                        <!-- Số sản phẩm -->
                        <TableColumn fx:id="categoryProductCountColumn" minWidth="120" prefWidth="150" text="%categories.col.products" />

                        <!-- Trạng thái -->
                        <TableColumn fx:id="categoryStatusColumn" minWidth="130" prefWidth="160" text="%history.col.status" />

                        <!-- Thao tác -->
                        <TableColumn fx:id="categoryActionColumn" minWidth="130" prefWidth="150" text="%customers.col.actions" />
                    </columns>

                    <placeholder>
                        <Label styleClass="empty-label" text="%categories.none.title" />
                    </placeholder>
                    <columnResizePolicy>
                        <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                    </columnResizePolicy>
                </TableView>

                <!-- ================= FOOTER ================= -->
                <HBox alignment="CENTER_LEFT" spacing="8">
                    <Label fx:id="categoryPaginationLabel" styleClass="table-footer" text="%categories.pagination.initial" />
                    <Region HBox.hgrow="ALWAYS" />
                    <HBox fx:id="categoryPagerBox" alignment="CENTER_RIGHT" />
                </HBox>

            </VBox>

        </VBox>
    </center>

</BorderPane>