<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.Tooltip?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane maxHeight="1000" maxWidth="1600" prefHeight="1000" prefWidth="1600" stylesheets="@../css/quanlytaikhoan.css" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.coffeeshop.coffeeshopmanagement.controller.StaffController">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="%nav.home"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openDashboard"/>

                <Button text="%nav.products"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openProductManagement"/>

                <Button text="%nav.orders"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="%nav.customers"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0">
                <Button text="%nav.categories"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCategoryManagement"/>

                <Button text="%nav.accounts"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openAccountManagement"/>

                <Button text="%nav.staff"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="%nav.logout"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="%nav.tagline"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- ================= MAIN CONTENT ================= -->
    <center>
        <VBox styleClass="content">

            <!-- ================= HEADER ================= -->
            <HBox alignment="CENTER_LEFT" prefHeight="72" spacing="10" styleClass="page-header">

                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label styleClass="page-title" text="%staff.title" />
                    <Label styleClass="page-description" text="%staff.subtitle" />
                </VBox>

                <Label styleClass="header-icon" text="♧" />

                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label styleClass="admin-name" text="Admin" />
                    <Label styleClass="admin-role" text="%role.admin" />
                </VBox>

                <Label styleClass="profile-icon" text="◎" />
            </HBox>

            <!-- ================= STATISTICS ================= -->
            <HBox spacing="12" styleClass="statistics">
                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon" text="●" />
                    <Label styleClass="stat-title" text="%staff.stat.total" />
                    <Label fx:id="totalStaffLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%staff.stat.total.caption" />
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon-active" text="●" />
                    <Label styleClass="stat-title" text="%staff.status.working" />
                    <Label fx:id="workingStaffLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%staff.stat.working.caption" />
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon-locked" text="●" />
                    <Label styleClass="stat-title" text="%staff.status.left" />
                    <Label fx:id="leftStaffLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%staff.stat.left.caption" />
                </VBox>

                <VBox styleClass="stat-card" HBox.hgrow="ALWAYS">
                    <Label styleClass="stat-icon" text="⬟" />
                    <Label styleClass="stat-title" text="%staff.stat.login" />
                    <Label fx:id="loginStaffLabel" styleClass="stat-value" text="0" />
                    <Label styleClass="stat-description" text="%staff.stat.login.caption" />
                </VBox>
            </HBox>

            <!-- ================= SEARCH + FILTER ================= -->
            <HBox alignment="CENTER_LEFT" spacing="8" styleClass="search-bar">
                <TextField fx:id="staffSearchField" onAction="#handleSearch" promptText="%staff.search.prompt" styleClass="search-field" HBox.hgrow="ALWAYS" />

                <ComboBox fx:id="staffStatusFilter" onAction="#handleFilterChange" prefWidth="160" promptText="%history.status.all" styleClass="filter-combo" />

                <ComboBox fx:id="staffLoginFilter" onAction="#handleFilterChange" prefWidth="170" promptText="%staff.filter.allaccounts" styleClass="filter-combo" />

                <Button fx:id="addStaffButton" mnemonicParsing="false" onAction="#handleAddStaff" styleClass="primary-button" text="%staff.add" />
            </HBox>

            <!-- ================= STAFF AREA ================= -->
            <HBox spacing="12" styleClass="account-area" VBox.vgrow="ALWAYS">

                <!-- ================= STAFF TABLE ================= -->
                <VBox spacing="10" styleClass="table-card" HBox.hgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="section-title" text="%staff.list.title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Label fx:id="staffCountLabel" styleClass="account-count" text="%staff.count.initial" />
                    </HBox>

                    <TableView fx:id="staffTable" onMouseClicked="#handleSelectStaff" styleClass="account-table" VBox.vgrow="ALWAYS">
                        <columns>
                            <TableColumn fx:id="staffIndexColumn" prefWidth="45" text="#" />
                            <TableColumn fx:id="staffNameColumn" prefWidth="170" text="%customers.col.name" />
                            <TableColumn fx:id="staffPhoneColumn" prefWidth="120" text="%customers.col.phone" />
                            <TableColumn fx:id="staffPositionColumn" prefWidth="120" text="%staff.col.position" />
                            <TableColumn fx:id="staffStartColumn" prefWidth="105" text="%staff.col.start" />
                            <TableColumn fx:id="staffLoginColumn" prefWidth="130" text="%staff.col.account" />
                            <TableColumn fx:id="staffStatusColumn" prefWidth="110" text="%history.col.status" />
                            <TableColumn fx:id="staffActionColumn" prefWidth="80" text="%customers.col.actions" />
                        </columns>
                        <placeholder>
                            <Label styleClass="empty-label" text="%staff.empty" />
                        </placeholder>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY" />
                        </columnResizePolicy>
                    </TableView>

                    <!-- ================= PAGINATION ================= -->
                    <HBox alignment="CENTER_LEFT" spacing="5">
                        <Label fx:id="staffPaginationLabel" styleClass="table-footer" text="%staff.pagination.initial" />
                        <Region HBox.hgrow="ALWAYS" />
                        <HBox fx:id="staffPagerBox" alignment="CENTER_RIGHT" />
                    </HBox>
                </VBox>

                <!-- ================= STAFF DETAIL ================= -->
                <VBox fx:id="staffDetailCard" maxWidth="300" minWidth="300" prefWidth="300" spacing="12" styleClass="detail-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="section-title" text="%staff.detail.title" />
                        <Region HBox.hgrow="ALWAYS" />
                        <Button mnemonicParsing="false" onAction="#handleCloseDetail" styleClass="close-button" text="×">
                            <tooltip><Tooltip text="%common.close"/></tooltip>
                        </Button>
                    </HBox>

                    <!-- ================= PROFILE ================= -->
                    <VBox alignment="CENTER" spacing="5" styleClass="profile-box">
                        <Label fx:id="detailName" styleClass="profile-name" text="%staff.detail.none" wrapText="true" />
                        <Label fx:id="detailState" styleClass="role-badge" text="%accounts.detail.empty" />
                    </VBox>

                    <!-- ================= INFORMATION ================= -->
                    <VBox spacing="10" styleClass="info-box">
                        <HBox>
                            <Label styleClass="info-label" text="%customers.col.phone" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailPhoneLabel" styleClass="info-value" text="-" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="%staff.detail.email" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailEmailLabel" styleClass="info-value" text="-" wrapText="true" maxWidth="170" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="%accounts.detail.position" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailPositionLabel" styleClass="info-value" text="-" wrapText="true" maxWidth="170" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="%accounts.detail.startdate" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailStartLabel" styleClass="info-value" text="-" wrapText="true" maxWidth="170" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="%accounts.detail.salary" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailSalaryLabel" styleClass="info-value" text="-" wrapText="true" maxWidth="170" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="%accounts.detail.address" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailAddressLabel" styleClass="info-value" text="-" wrapText="true" maxWidth="170" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="%staff.col.account" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailLoginLabel" styleClass="info-value" text="-" wrapText="true" maxWidth="170" />
                        </HBox>

                        <HBox>
                            <Label styleClass="info-label" text="%accounts.detail.role" />
                            <Region HBox.hgrow="ALWAYS" />
                            <Label fx:id="detailRoleLabel" styleClass="info-value" text="-" />
                        </HBox>
                    </VBox>

                    <Region VBox.vgrow="ALWAYS" />

                    <!-- ================= ACTIONS ================= -->
                    <HBox spacing="8">
                        <Button fx:id="editStaffButton" mnemonicParsing="false" onAction="#handleEditStaff" styleClass="secondary-button" text="%common.edit.button" HBox.hgrow="ALWAYS" />

                        <Button fx:id="leftStaffButton" mnemonicParsing="false" onAction="#handleToggleWorking" styleClass="danger-button" text="%staff.button.left" HBox.hgrow="ALWAYS" />
                    </HBox>

                </VBox>

            </HBox>

        </VBox>
    </center>

</BorderPane>
