<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>

<BorderPane fx:id="dashboardRoot"
            prefWidth="1600.0"
            prefHeight="1000.0"
            minWidth="1600.0"
            minHeight="1000.0"
            maxWidth="1600.0"
            maxHeight="1000.0"
            stylesheets="@../css/employee-trangchu.css"
            xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.coffeeshop.coffeeshopmanagement.controller.EmployeeController"
            styleClass="dashboard">

    <!-- SIDEBAR -->
    <left>
        <VBox prefWidth="270.0"
              maxWidth="270.0"
              styleClass="sidebar">

            <VBox alignment="CENTER" prefHeight="150.0">
                <ImageView fitHeight="100.0" fitWidth="180.0" preserveRatio="true">
                    <image>
                        <Image url="@../images/LunaveraLogo.png"/>
                    </image>
                </ImageView>
            </VBox>

            <Separator styleClass="sidebar-separator"/>

            <VBox spacing="6.0" VBox.vgrow="NEVER">
                <Button text="%nav.home"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button,menu-button-active"/>

                <Button text="%nav.orders"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openOrderManagement"/>

                <Button text="%nav.customers"
                        prefHeight="48.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="menu-button"
                        onAction="#openCustomerManagement"/>
            </VBox>

            <Region VBox.vgrow="ALWAYS"/>

            <VBox alignment="CENTER_LEFT" spacing="8.0">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
                <Button text="%nav.logout"
                        prefHeight="42.0"
                        maxWidth="1.7976931348623157E308"
                        styleClass="logout-button"
                        onAction="#logout"/>

                <Label text="%nav.tagline"
                       styleClass="sidebar-footer"/>
            </VBox>
        </VBox>
    </left>

    <!-- MAIN CONTENT -->
    <center>
        <VBox spacing="20.0" styleClass="content">

            <!-- HEADER -->
            <HBox alignment="CENTER_LEFT" prefHeight="70.0">
                <VBox spacing="4.0">
                    <Label fx:id="dashboardGreetingLabel" text="%dashboard.greeting.default" styleClass="page-title"/>
                    <Label text="%dashboard.subtitle"
                           styleClass="page-subtitle"/>
                </VBox>

                <Region HBox.hgrow="ALWAYS"/>

                <VBox alignment="CENTER_RIGHT" spacing="3.0">
                    <Label fx:id="dashboardAccountNameLabel" text="Employee" styleClass="account-name"/>
                    <Label text="%role.employee" styleClass="account-role"/>
                </VBox>
            </HBox>

            <!-- STATISTICS -->
            <GridPane hgap="16.0" vgap="16.0">
                <columnConstraints>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                    <ColumnConstraints percentWidth="25.0"/>
                </columnConstraints>

                <VBox GridPane.columnIndex="0"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.products.title" styleClass="stat-title"/>
                    <Label fx:id="dashboardProductCountLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label fx:id="dashboardLowStockNoteLabel"
                           text="%common.loading"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="1"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.orders.title" styleClass="stat-title"/>
                    <Label fx:id="todayOrderLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="%stats.orders.caption"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="2"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.revenue.title" styleClass="stat-title"/>
                    <Label fx:id="todayRevenueLabel"
                           text="%money.zero"
                           styleClass="stat-value"/>
                    <Label text="%stats.revenue.caption"
                           styleClass="stat-description"/>
                </VBox>

                <VBox GridPane.columnIndex="3"
                      prefHeight="145.0"
                      styleClass="stat-card">
                    <Label text="%stats.customers.title" styleClass="stat-title"/>
                    <Label fx:id="todayCustomerLabel"
                           text="0"
                           styleClass="stat-value"/>
                    <Label text="%stats.customers.caption"
                           styleClass="stat-description"/>
                </VBox>
            </GridPane>

            <!-- TABLE + INVENTORY -->
            <HBox spacing="16.0" VBox.vgrow="ALWAYS">

                <!-- SƠ ĐỒ BÀN PHỤC VỤ (12 BÀN) -->
                <VBox prefWidth="850.0"
                      spacing="14.0"
                      styleClass="content-card"
                      HBox.hgrow="ALWAYS">

                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <VBox spacing="3.0">
                            <Label text="%tables.map.title"
                                   styleClass="section-title"/>
                            <Label text="%tables.map.subtitle"
                                   styleClass="section-subtitle"/>
                        </VBox>

                        <Region HBox.hgrow="ALWAYS"/>

                        <!-- STATUS LEGENDS -->
                        <HBox spacing="14.0" alignment="CENTER">
                            <HBox spacing="6.0" alignment="CENTER">
                                <Label text="●" styleClass="status-dot-occupied"/>
                                <Label text="%tables.status.occupied" styleClass="status-legend-text"/>
                            </HBox>

                            <HBox spacing="6.0" alignment="CENTER">
                                <Label text="●" styleClass="status-dot-empty"/>
                                <Label text="%tables.status.free" styleClass="status-legend-text"/>
                            </HBox>
                        </HBox>
                    </HBox>

                    <!-- TABLE MAP: rows are made in code from the list of tables and it scrolls when there are many (TODO 3.48) -->
                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" VBox.vgrow="ALWAYS"
                                style="-fx-background-color: transparent; -fx-background: transparent;">
                        <GridPane fx:id="homeTableGrid" hgap="12.0" vgap="12.0">
                            <columnConstraints>
                                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                                <ColumnConstraints percentWidth="33.333" hgrow="ALWAYS"/>
                            </columnConstraints>
                        </GridPane>
                    </ScrollPane>
                </VBox>

                <!-- INVENTORY -->
                <VBox prefWidth="350.0"
                      spacing="12.0"
                      styleClass="content-card">

                    <HBox alignment="CENTER_LEFT">
                        <Label text="%stock.alert.title"
                               styleClass="section-title"/>
                    </HBox>

                    <VBox fx:id="lowStockList" spacing="12.0"/>

                    <Region VBox.vgrow="ALWAYS"/>


                </VBox>
            </HBox>

        </VBox>
    </center>
</BorderPane>